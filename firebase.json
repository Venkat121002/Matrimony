{
  "functions": [
    {
      "source": "backend",
      "codebase": "matrimony",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "uploads",
        "test_integration.js"
      ]
    }
  ],
  "firestore": {
    "database": "tamil-nikah",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "bucket": "swordnex-client-server",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "matrimonyApi",
          "region": "asia-south1"
        }
      },
      {
        "source": "/uploads/**",
        "function": {
          "functionId": "matrimonyApi",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "site": "tamil-muslim-nikkah"
  }
}
